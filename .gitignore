# 本机私密配置：里面有你的 API Key，绝对不要提交或打包给别人
.env

# 虚拟环境
.venv/
venv/

# 每次生成的产物（体积大，且含你的主题内容）
output/
# 例外：首页「示例作品」里那支 PPT 示例（20260911-lingnan-agriculture）
# 是随仓库走的，约 20MB。这样云端部署也能看到示例，不会是一片空白
# ——Render 免费档的磁盘是临时的，重启就清空，光靠本机生成的产物传不上去。
# 它是用 git add -f 强制加入的；.gitignore 对已跟踪文件不起作用，
# 所以以后更新这批文件，普通的 git add 就会带上。
# 不想让它占仓库体积的话：git rm -r --cached output/20260911-lingnan-agriculture

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 穿透工具（cloudflared 约 52MB 二进制，本机用，不进仓库）
# 需要时运行 tools\get-cloudflared.bat 自动下载
tools/bin/
