# 本机私密配置：里面有你的 API Key，绝对不要提交或打包给别人
.env

# 虚拟环境
.venv/
venv/

# 每次生成的产物（体积大，且含你的主题内容）
output/
# 注意：首页「示例作品」里那支 PPT 示例（岭南农耕文化）不在 output/ 下，
# 而是放在 examples/ 里随仓库走 —— 因为 .dockerignore 排除了 output/，
# 且 Dockerfile 里 VOLUME /app/output 是个挂载点，放在 output/ 里的东西
# 既进不了镜像也留不住。启动时再复制进 output/，见 app.py 的 _seed_examples。

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 穿透工具（cloudflared 约 52MB 二进制，本机用，不进仓库）
# 需要时运行 tools\get-cloudflared.bat 自动下载
tools/bin/
