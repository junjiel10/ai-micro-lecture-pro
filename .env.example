# ============================================================
# 妙课生花 WonderKourse · 可选配置
# 把本文件复制为 .env 即可生效（不配置也能完整使用）
# ============================================================

# ---------- 大模型（可选）----------
# 留空 → 使用「内置教学脚本引擎」（规则 + 学科知识骨架），功能完整可用
# 填写 → 自动升级为大模型生成脚本与旁白，界面会显示「大模型模式」
#
# OpenAI 兼容接口均可，下面给出几个常见例子：

# --- DeepSeek ---
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# --- 阿里通义千问 ---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# --- 智谱 GLM ---
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# --- 月之暗面 Kimi ---
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k

# --- 本地 Ollama ---
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# ---------- 配音音色 ----------
# zh-CN-YunxiNeural     云希 · 男声（默认，讲述感强）
# zh-CN-XiaoxiaoNeural  晓晓 · 女声（亲和）
# zh-CN-YunyangNeural   云扬 · 新闻男声（正式）
# zh-CN-XiaoyiNeural    晓伊 · 女声（年轻）
TTS_VOICE=zh-CN-YunxiNeural

# 语速（+8% 稍快，适合知识讲解；朗读感太重可改为 +0%）
TTS_RATE=+8%

# ---------- 画面比例 ----------
# landscape  横版 16:9（1920×1080）→ 电脑、投影、B 站
# portrait   竖版 9:16（1080×1920）→ 手机端（抖音 / 视频号 / 小红书）
# 也可以在网页创作台的「画面比例」里逐个项目选择，网页选择优先
VIDEO_FORMAT=landscape

# ---------- 插图 ----------
# 1 开：按分镜语义自动生成「概念结构图 / 流程链 / 标签云 / 对照板」等结构化插图
# 0 关：只用纯文字版式
ILLUSTRATIONS=1

# ---------- 可选：外部「文生图」（一般用不到）----------
# 默认的插图是本机程序化绘制的结构化图形：准确、免费、无需联网。
# 如果你确实需要写实配图，可填入 OpenAI 兼容的图像接口（如通义万相、智谱 CogView）：
# IMAGE_API_KEY=sk-xxxx
# IMAGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# IMAGE_MODEL=wanx2.1-t2i-turbo

# ---------- 其他 ----------
# 背景音乐开关（1 开 / 0 关）
BGM_ENABLED=1

# 字幕字体族名：**默认可不填**，程序会跟着本机实际找到的字体自动判定
#   Windows → Microsoft YaHei   Linux 容器 → Noto Sans CJK SC
# 只有自动判定出错时才需要手动指定（比如你装了别的不常见字体）。
# SUBTITLE_FONT_NAME=Microsoft YaHei

# ============================================================
# 下面是「部署到公网」时才需要关心的开关，本机自用可以整段不管
# ============================================================

# ---------- 监听地址 ----------
# 本机自用留空即可（默认 127.0.0.1:8000）
# Docker / 云平台用 HOST=0.0.0.0，端口由平台的 PORT 变量决定
# HOST=0.0.0.0

# ---------- 访问口令（公网部署强烈建议开启）----------
# 设了 ACCESS_PASSWORD 就启用 HTTP Basic 认证：
# 浏览器会弹出原生登录框，用户名是 ACCESS_USER，密码是你设的这个值。
# 不设的话，任何人拿到网址都能点「开始制作」，烧你的 CPU 和大模型额度。
# ACCESS_USER=demo
# ACCESS_PASSWORD=换成一个够长的口令

# ---------- 是否允许网页端改服务器配置 ----------
# 网页端「⚙ 大模型设置」会写入服务器上的 .env。
# 只监听本机 → 默认允许；监听 0.0.0.0 → 默认禁止。
# 线上确实想开，才设 1（有被人把接口地址改走、套出 Key 的风险）。
# ALLOW_WEB_SETTINGS=0
